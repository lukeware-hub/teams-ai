{
  "name": "teams-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:budget": "tsx scripts/test-budget.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "teams-ai": "tsx --no-warnings=ExperimentalWarning server/cli.ts",
    "ui": "tsx --no-warnings=ExperimentalWarning server/cli.ts ui",
    "web:install": "cd web && npm install --no-audit --no-fund",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "test:web": "cd web && npm test"
  },
  "dependencies": {
    "diff": "8.0.2",
    "fast-xml-parser": "5.11.1",
    "picomatch": "4.0.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/diff": "8.0.0",
    "@types/node": "22.20.4",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "5.0.1",
    "puppeteer-core": "^25.16.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "yaml": "^2.9.1"
  }
}
