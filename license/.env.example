# 32 bytes, base64. Encrypts the license key so the admin can see it again.
LICENSE_MASTER_KEY=
# Admin login secret, at least 16 characters.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
LICENSE_DB_PASSWORD=license
DATABASE_URL=postgres://license:license@127.0.0.1:5432/license?sslmode=disable
PORT=8080
