# 32 bytes, base64. Encrypts the license key so the admin can see it again.
LICENSE_MASTER_KEY=
# 32-byte Ed25519 seed, hex. Signs the license token the teams-ai backend checks offline.
LICENSE_SIGNING_KEY=
# PKCS#8 RSA private key, base64. Decrypts the X-Teams-AI-Key header teams-ai sends.
LICENSE_CLIENT_PRIVATE_KEY=
# Admin login secret, at least 16 characters.
JWT_SECRET=
# First administrator, created only while the admin table is empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Only for running the service outside Compose; Compose sets DATABASE_URL and PORT itself.
DATABASE_URL=postgres://license:license@127.0.0.1:5432/license?sslmode=disable
PORT=8080
