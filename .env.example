# GITHUB_TOKEN=
# CLAUDE_CODE_OAUTH_TOKEN=
# Host interface for the UI on port 8787. Use 0.0.0.0 to reach it from the LAN; the UI has no password.
# TEAMS_AI_UI_BIND=127.0.0.1
# Extra Host header values the API accepts, comma separated (for example a LAN hostname).
# TEAMS_AI_ALLOWED_HOSTS=
# Image to run instead of building from source.
# TEAMS_AI_IMAGE=ghcr.io/diego-dm-morais/teams-ai:latest
# License service address. The default inside Compose is http://license:8080.
# LICENSE_SERVICE_URL=http://license:8080
# License service secrets go in license/.env, not here.
