# GITHUB_TOKEN=
# CLAUDE_CODE_OAUTH_TOKEN=
# Host interface for the UI on port 8787. 0.0.0.0 gives full API access to anyone on the LAN; use it only on a trusted network.
# TEAMS_AI_UI_BIND=127.0.0.1
# Extra Host header values the API accepts, comma separated (for example a LAN hostname).
# TEAMS_AI_ALLOWED_HOSTS=
# Refinement rounds after which Executar opens even with checks still failing (default 5).
# TEAMS_AI_REFINE_RELEASE_ROUNDS=5
# Refinement rounds after which Reavaliar stops and asks for a decision (default 10).
# TEAMS_AI_REFINE_MAX_ROUNDS=10
# Image to run instead of building from source.
# TEAMS_AI_IMAGE=ghcr.io/lukeware-hub/teams-ai:latest
# License service address. The default inside Compose is http://license:8080.
# LICENSE_SERVICE_URL=http://license:8080
# License service secrets go in license/.env, not here.
